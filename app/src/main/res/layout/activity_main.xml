<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050b18"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0a1628"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/d4ai_logo"
            android:contentDescription="@string/app_name" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D4AI"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online · v1.1"
                android:textColor="#34d399"
                android:textSize="11sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnAuto"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Auto-talk On"
            android:textSize="11sp" />
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Menu"
            android:src="@android:drawable/ic_menu_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/listenBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0a1a30"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="#22d3ee"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#07101e"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Microphone"
            android:src="@android:drawable/ic_btn_speak_now" />
        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="#0b1a33"
            android:hint="Message D4AI..."
            android:paddingHorizontal="14dp"
            android:textColor="#E2E8F0"
            android:textColorHint="#64748B"
            android:textSize="14sp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="4" />
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Send"
            android:src="@drawable/d4ai_logo" />
    </LinearLayout>
</LinearLayout>
